---
layout: null
sitemap: false
permalink: /search.json
---
[
{%- for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "excerpt": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 180 | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | truncate: 8000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
